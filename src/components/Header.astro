<header class="app-header">
    <div class="left">
        <button
            class="icon-btn btn-restart"
            data-action="restart"
            title="Restart game"
            aria-label="Restart game"></button>
    </div>

    <h1 class="title">Stacking My Wins with Connect 4!</h1>

    <div class="right">
        <button
            class="icon-btn btn-audio"
            data-action="toggle-audio"
            title="Toggle audio"
            aria-pressed="true"
            aria-label="Toggle audio"></button>
        <button
            class="icon-btn btn-info"
            data-action="show-info"
            title="How to play"
            aria-label="How to play"></button>
    </div>
</header>
